# Required — bearer token for API authentication.
# Use a long, random secret, e.g. `openssl rand -hex 32`. A startup warning fires
# for short, low-entropy, or placeholder tokens.
UPREDIS_TOKEN=your-secret-token-here

# Bundled backend image (docker-compose.yml). Default: redis:8-alpine.
# UPREDIS_REDIS_IMAGE=redis:8-alpine            # Redis 8 (default; core + Vector Sets only)
# UPREDIS_REDIS_IMAGE=redis:7-alpine            # Redis 7 (previous default; CI baseline)
# UPREDIS_REDIS_IMAGE=valkey/valkey:9-alpine    # Valkey 9 (BSD-licensed; no AGPL)
# UPREDIS_REDIS_IMAGE=redis/redis-stack-server  # + RedisJSON/Search/TimeSeries/Bloom (large, Debian)

# Redis connection (any Redis 6+ / Valkey / KeyDB).
# Bundled backend (docker-compose.yml): redis://redis:6379
# Managed/external: set host, PORT, and credentials from your provider console.
#   Many managed backends use a NON-standard port — Azure 6380/10000, GCP 6378,
#   Redis Cloud / Aiven per-instance high ports. Don't assume 6379.
# UPREDIS_REDIS_URL=redis://localhost:6379
# UPREDIS_REDIS_URL=rediss://default:PASSWORD@your-host.example.com:6380

# HTTP server
# UPREDIS_PORT=8080
# UPREDIS_HOST=0.0.0.0

# Logging
# UPREDIS_LOG_LEVEL=info          # debug, info, warn, error
# UPREDIS_LOG_FORMAT=json          # json, text

# Graceful shutdown
# UPREDIS_SHUTDOWN_TIMEOUT=30000   # Max ms to wait for request drain

# Per-request timeout (0 = disabled)
# UPREDIS_REQUEST_TIMEOUT=30000

# Maximum request body size in bytes (default: 10MB)
# UPREDIS_MAX_BODY_SIZE=10485760

# Maximum commands per pipeline / multi-exec request
# UPREDIS_MAX_PIPELINE_COMMANDS=1000

# Maximum concurrent SSE pubsub subscriptions (each holds a dedicated Redis connection)
# UPREDIS_MAX_SUBSCRIPTIONS=10000

# Prometheus metrics endpoint (GET /metrics)
# UPREDIS_METRICS=false

# Block KEYS / FLUSHALL / FLUSHDB / SWAPDB by default; set true to permit them
# UPREDIS_ALLOW_DANGEROUS_COMMANDS=false

# Extra commands to block (comma-separated, case-insensitive), e.g. DEBUG,KEYS
# UPREDIS_BLOCKED_COMMANDS=

# Allow ?_token= query-param auth (Upstash compat). Set false to require the
# Authorization header and avoid leaking the token into reverse-proxy logs.
# UPREDIS_ALLOW_TOKEN_QUERY_PARAM=true
